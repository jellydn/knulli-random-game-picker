#!/usr/bin/env bash
set -euo pipefail

packages=(
  build-essential pkg-config curl ca-certificates
  libsdl2-dev libsdl2-image-dev libsdl2-ttf-dev libsdl2-gfx-dev
  python3 python3-yaml shellcheck fonts-dejavu-core
)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done

if ((${#missing[@]})); then
  elevate=()
  if ((EUID != 0)); then
    elevate=(sudo)
  fi
  echo "Installing missing host development packages: ${missing[*]}"
  "${elevate[@]}" apt-get update -qq
  "${elevate[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
else
  echo 'All host development packages are already installed.'
fi

if [[ ! -x /usr/local/go/bin/go ]] || [[ "$(/usr/local/go/bin/go version)" != *'go1.26.0 '* ]]; then
  temporary=$(mktemp -d)
  trap 'rm -rf "$temporary"' EXIT
  curl -fsSL https://go.dev/dl/go1.26.0.linux-amd64.tar.gz -o "$temporary/go.tar.gz"
  echo "aac1b08a0fb0c4e0a7c1555beb7b59180b05dfc5a3d62e40e9de90cd42f88235  $temporary/go.tar.gz" | sha256sum -c -
  elevate=()
  if ((EUID != 0)); then elevate=(sudo); fi
  "${elevate[@]}" tar -C /usr/local -xzf "$temporary/go.tar.gz"
fi
export PATH="/usr/local/go/bin:$PATH"
go version
go mod download
pkg-config --modversion sdl2 SDL2_image SDL2_ttf SDL2_gfx
echo 'Host setup ready. Run ./scripts/check. Hardware validation remains separate.'
