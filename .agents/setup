#!/usr/bin/env bash
set -euo pipefail

packages=(
  build-essential cmake ninja-build pkg-config
  libsdl2-dev libsdl2-image-dev libsdl2-ttf-dev
  libpugixml-dev nlohmann-json3-dev
  python3 python3-yaml shellcheck
)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done

if ((${#missing[@]})); then
  elevate=()
  if ((EUID != 0)); then
    elevate=(sudo)
  fi
  echo "Installing missing host development packages: ${missing[*]}"
  "${elevate[@]}" apt-get update -qq
  "${elevate[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
else
  echo 'All host development packages are already installed.'
fi

c++ --version | head -n 1
cmake --version | head -n 1
ninja --version
pkg-config --modversion sdl2 SDL2_image SDL2_ttf pugixml
echo 'Host setup ready. Run ./scripts/check for documentation, shell, and dependency checks.'
echo 'KNULLI cross-compilation and real-device validation remain M0/M1 work.'
