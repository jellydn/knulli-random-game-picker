#!/usr/bin/env bash
set -euo pipefail

root="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")"
pushd "$root" >/dev/null

bash -n .agents/setup scripts/check
shellcheck .agents/setup scripts/check
/usr/bin/python3 scripts/check-docs.py

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT

# This probe validates host headers and linking, not the application or a device.
cat >"$temporary/dependencies.cpp" <<'CPP'
#include <SDL.h>
#include <SDL_image.h>
#include <SDL_ttf.h>
#include <pugixml.hpp>
#include <nlohmann/json.hpp>
#include <optional>

int main() {
    SDL_version version{};
    SDL_GetVersion(&version);
    const auto* image = IMG_Linked_Version();
    const auto* font = TTF_Linked_Version();
    pugi::xml_document document;
    if (!document.load_string("<probe/>")) return 1;
    const nlohmann::json data = {{"ready", true}};
    const std::optional<bool> ready = data.at("ready").get<bool>();
    return version.major == 2 && image && font && ready.value() ? 0 : 1;
}
CPP

# pkg-config deliberately supplies separate compiler and linker arguments.
# shellcheck disable=SC2046
c++ -std=c++17 -Wall -Wextra -Werror "$temporary/dependencies.cpp" \
  $(pkg-config --cflags --libs sdl2 SDL2_image SDL2_ttf pugixml) \
  -o "$temporary/dependencies"
"$temporary/dependencies"
echo 'PASS: C++17 host dependency compile/link/load probe (no display or hardware test).'
popd >/dev/null
