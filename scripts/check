#!/usr/bin/env bash
set -euo pipefail

root="$(dirname "$(dirname "$(realpath "${BASH_SOURCE[0]}")")")"
pushd "$root" >/dev/null

./scripts/lint
python3 tests/package-device.py

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT

export PATH="/usr/local/go/bin:$PATH"
export GOFLAGS='-tags=nodefaultfont,nonextuifonts'
go test -race ./...
mkdir -p build/host/assets
go build -trimpath -o build/host/random-game-picker ./cmd/random-game-picker
go build -trimpath -o "$temporary/http-client" ./tests/http-client
cp /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf build/host/assets/
# This test-only shim injects logical SDL events, not raw hardware indices.
# shellcheck disable=SC2046
c++ -shared -fPIC tests/controller-events.cpp $(pkg-config --cflags --libs sdl2) -ldl -o build/host/libcontroller-events.so
python3 tests/http-contract.py "$temporary/http-client"
echo 'PASS: Go format, modules, vet, race tests, host build and loopback contract.'
popd >/dev/null
